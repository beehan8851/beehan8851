    "Last night, the week's nights, and the way into a calmer bedtime." : {
      "comment" : "Widget gallery description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Nacht, die Nächte der Woche und der Weg zu einem ruhigeren Abend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anoche, las noches de la semana y el camino a una noche más tranquila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit dernière, les nuits de la semaine et le chemin vers un coucher plus calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieri notte, le notti della settimana e la via per una sera più calma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨夜の睡眠、今週の夜、そして穏やかな寝る前の時間へ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난밤, 이번 주의 밤들, 그리고 더 차분한 잠자리로."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontem à noite, as noites da semana e o caminho para uma hora de dormir mais calma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прошлая ночь, ночи недели и путь к спокойному отходу ко сну."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dün gece, haftanın geceleri ve daha sakin bir yatma vakti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚、本周的每一夜，以及通往更平静睡前时光的入口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚、本週的每一夜，以及通往更平靜睡前時光的入口。"
          }
        }
      }
    },
