    "The cat sleeps when you do and celebrates your mornings." : {
      "comment" : "Widget gallery description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Katze schläft, wenn du schläfst, und feiert deine Morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gato duerme cuando tú duermes y celebra tus mañanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chat dort quand vous dormez et fête vos matins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gatto dorme quando dormi tu e festeggia le tue mattine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが眠るとネコも眠り、朝を一緒に喜びます。"
