    "Cancel any time in Settings › Apple Account › Subscriptions, at least 24 hours before the period ends." : {
      "comment" : "Subscription cancellation instructions",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit kündbar unter Einstellungen › Apple-Account › Abos, mindestens 24 Stunden vor Ende des Zeitraums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela cuando quieras en Ajustes › Cuenta de Apple › Suscripciones, al menos 24 horas antes de que termine el periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulable à tout moment dans Réglages › Compte Apple › Abonnements, au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disdire quando vuoi in Impostazioni › Account Apple › Abbonamenti, almeno 24 ore prima della fine del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約は、期間終了の24時間以上前に、設定 › Appleアカウント › サブスクリプション からいつでも行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간이 끝나기 최소 24시간 전에 설정 › Apple 계정 › 구독에서 언제든 해지할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele quando quiser em Ajustes › Conta Apple › Assinaturas, pelo menos 24 horas antes do fim do período."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить можно в любой момент в Настройках › Аккаунт Apple › Подписки, не позднее чем за 24 часа до конца периода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dönem bitmeden en az 24 saat önce Ayarlar › Apple Hesabı › Abonelikler'den istediğin zaman iptal edebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
