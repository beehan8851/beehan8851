    "Enable Alarms & Timers in Settings so alarms ring through Silent mode and Focus." : {
      "comment" : "AlarmKit banner body",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Wecker & Timer“ in den Einstellungen, damit Wecker im Lautlos-Modus und bei Fokus klingeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Alarmas y temporizadores en Ajustes para que las alarmas suenen en modo Silencio y con Concentración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Alarmes et minuteurs dans Réglages pour que les alarmes sonnent en mode Silencieux et en Concentration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Sveglie e timer in Impostazioni per far suonare le sveglie in modalità Silenzioso e con Full Immersion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で「アラームとタイマー」を有効にすると、消音モードや集中モードでもアラームが鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 '알람 및 타이머'를 켜면 무음 모드와 집중 모드에서도 알람이 울립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Alarmes e Timers em Ajustes para que os alarmes toquem no modo Silencioso e com o Foco ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Будильники и таймеры» в Настройках, чтобы будильники звонили в беззвучном режиме и при Фокусировании."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmların Sessiz modda ve Odak açıkken çalması için Ayarlar'dan Alarmlar ve Zamanlayıcılar'ı etkinleştir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置中开启“闹钟与计时器”，让闹钟在静音模式和专注模式下也能响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中開啟「鬧鐘與計時器」，讓鬧鐘在靜音模式和專注模式下也能響。"
          }
        }
      }
    },
