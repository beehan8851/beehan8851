    "Tap to confirm you're awake, or the alarm rings again in 2 minutes." : {
      "comment" : "Wake check notification body no label",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um zu bestätigen, dass du wach bist – sonst klingelt der Wecker in 2 Minuten erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
