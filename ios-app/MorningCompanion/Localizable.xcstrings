    "That plan couldn't be loaded from the App Store. Pull to retry." : {
      "comment" : "Subscription plan missing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tarif konnte nicht aus dem App Store geladen werden. Zum Wiederholen ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese plan no se pudo cargar desde el App Store. Desliza para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
