        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猫と呼吸中。呼吸が切り替わるたびにやさしく振動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고양이와 호흡 중. 호흡이 바뀔 때마다 부드럽게 진동합니다."
