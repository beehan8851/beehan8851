          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дыхание с котом. Мягкая вибрация отмечает каждую смену вдоха и выдоха."
          }
        },
        "tr" : {
          "stringUnit" : {
