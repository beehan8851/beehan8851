    "Camera access is required to scan QR codes.\nEnable it in Settings." : {
      "comment" : "Camera permission denied\nQR camera denied",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Scannen von QR-Codes wird Kamerazugriff benötigt.\nAktiviere ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la cámara para escanear códigos QR.\nActívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à l'appareil photo est nécessaire pour scanner des QR codes.\nActivez-le dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scansionare i codici QR serve l'accesso alla fotocamera.\nAttivalo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードの読み取りにはカメラへのアクセスが必要です。\n設定で有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드를 스캔하려면 카메라 접근 권한이 필요합니다.\n설정에서 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário acesso à câmera para ler QR Codes.\nAtive em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для сканирования QR-кодов нужен доступ к камере.\nВключите его в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kodlarını taramak için kamera erişimi gerekiyor.\nAyarlar'dan etkinleştir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描二维码需要相机访问权限。\n请在设置中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描 QR Code 需要相機取用權限。\n請在設定中開啟。"
          }
        }
      }
    },
    "Camera access is restricted on this device, so the QR mission can't be used." : {
      "comment" : "QR mission camera restricted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist auf diesem Gerät eingeschränkt, deshalb lässt sich die QR-Mission nicht nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está restringido en este dispositivo, así que la misión QR no se puede usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à l'appareil photo est restreint sur cet appareil, la mission QR est donc indisponible."
          }
        },
        "it" : {
          "stringUnit" : {
