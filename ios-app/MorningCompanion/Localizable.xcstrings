    "A collar with a yolk bell, everywhere the cat goes." : {
      "comment" : "Cat trick detail: collar",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Halsband mit gelber Glocke, überall, wo die Katze ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un collar con un cascabel amarillo, vaya donde vaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un collier avec un grelot jaune, partout où va le chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un collare con un campanellino giallo, ovunque vada il gatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄色い鈴のついた首輪。どこへ行くときも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노란 방울이 달린 목걸이, 어디를 가든."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma coleira com um guizo amarelo, aonde o gato for."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошейник с жёлтым колокольчиком — всегда при коте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarı çıngıraklı bir tasma, kedi nereye giderse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂着黄色铃铛的项圈，走到哪儿戴到哪儿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掛著黃色鈴鐺的項圈，走到哪兒戴到哪兒。"
          }
        }
      }
    },
    "A gold medal on its collar, for a hundred mornings." : {
      "comment" : "Cat trick detail: medal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Goldmedaille am Halsband, für hundert Morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una medalla de oro en el collar, por cien mañanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une médaille d’or au collier, pour cent matins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una medaglia d’oro sul collare, per cento mattine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首輪に金メダル。100日の朝のごほうび。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목걸이에 금메달, 백 번의 아침을 위해."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma medalha de ouro na coleira, por cem manhãs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Золотая медаль на ошейнике — за сто утр."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasmada altın madalya, yüz sabah için."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项圈上挂一枚金牌，献给一百个早晨。"
          }
        },
        "zh-Hant" : {
