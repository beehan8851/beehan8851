    "Dawnwick Premium renews automatically at %@ per %@ until you cancel. %@" : {
      "comment" : "Auto-renew disclosure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium verlängert sich automatisch für %@ pro %@, bis du kündigst. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium se renueva automáticamente por %@ al %@ hasta que lo canceles. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium se renouvelle automatiquement à %@ par %@ jusqu'à annulation. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium si rinnova automaticamente a %@ ogni %@ finché non disdici. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premiumは、解約するまで%@ごとに%@で自動更新されます。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium은 해지할 때까지 %@마다 %@에 자동 갱신됩니다. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dawnwick Premium é renovado automaticamente por %@ a cada %@ até você cancelar. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium продлевается автоматически за %@ в %@, пока вы не отмените подписку. %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium, sen iptal edene kadar %@ başına %@ tutarında otomatik olarak yenilenir. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium 将按每 %@ %@ 自动续订，直至你取消。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Premium 將以每 %@ %@ 自動續訂，直到你取消為止。%@"
          }
        }
      }
    },
    "Dawnwick reads the sleep your iPhone or Watch already records. Nothing leaves your device." : {
      "comment" : "HealthKit not connected message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick liest den Schlaf, den dein iPhone oder deine Watch ohnehin aufzeichnet. Nichts verlässt dein Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick lee el sueño que tu iPhone o tu Watch ya registran. Nada sale de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick lit le sommeil que votre iPhone ou votre Watch enregistre déjà. Rien ne quitte votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick legge il sonno che il tuo iPhone o il tuo Watch registrano già. Niente lascia il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DawnwickはiPhoneやApple Watchがすでに記録している睡眠を読み取ります。データが端末の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick은 iPhone이나 Apple Watch가 이미 기록한 수면을 읽습니다. 데이터는 기기 밖으로 나가지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dawnwick lê o sono que seu iPhone ou Watch já registra. Nada sai do seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick читает данные о сне, которые ваш iPhone или Apple Watch уже записывают. Ничего не покидает устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick, iPhone'unun ya da Watch'unun zaten kaydettiği uyku verisini okur. Hiçbir şey cihazından çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 读取你的 iPhone 或 Apple Watch 已经记录的睡眠数据。数据不会离开你的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 會讀取你的 iPhone 或 Apple Watch 已經記錄的睡眠資料。資料不會離開你的裝置。"
          }
        }
      }
    },
    "Dawnwick rings through Silent mode and Focus, then asks you to do one small thing before it stops." : {
      "comment" : "Onboarding subtitle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick klingelt im Lautlos-Modus und bei Fokus und verlangt dann eine kleine Aufgabe, bevor es aufhört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick suena en modo Silencio y con Concentración, y luego te pide una pequeña tarea antes de parar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick sonne en mode Silencieux et en Concentration, puis vous demande une petite tâche avant de s'arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick suona in modalità Silenzioso e con Full Immersion, poi ti chiede una piccola cosa prima di fermarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwickは消音モードや集中モードでも鳴り、止まる前に小さな課題を1つ出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick은 무음 모드와 집중 모드에서도 울리고, 멈추기 전에 작은 과제 하나를 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dawnwick toca no modo Silencioso e com o Foco ativo, e então pede uma tarefinha antes de parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick звонит в беззвучном режиме и при включённом Фокусировании, а перед выключением просит выполнить одно небольшое задание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick Sessiz modda ve Odak açıkken de çalar, durmadan önce senden küçük bir şey yapmanı ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 在静音模式和专注模式下也会响，并在停止前让你完成一件小事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 在靜音模式和專注模式下也會響，並在停止前請你完成一件小事。"
          }
        }
      }
    },
    "Dawnwick uses the system alarm, so it sounds even when your phone is silenced. iOS will ask you twice." : {
      "comment" : "Onboarding permissions subtitle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick nutzt den Systemwecker und klingelt deshalb auch bei stummgeschaltetem Telefon. iOS fragt dich zweimal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick usa la alarma del sistema, así que suena aunque el teléfono esté en silencio. iOS te lo preguntará dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick utilise l'alarme système : elle sonne même téléphone en silencieux. iOS vous demandera deux autorisations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick usa la sveglia di sistema, quindi suona anche con il telefono silenziato. iOS ti farà due richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwickはシステムのアラームを使うため、消音中でも鳴ります。iOSから2回確認があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick은 시스템 알람을 사용해 무음 상태에서도 울립니다. iOS가 두 번 물어봅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dawnwick usa o alarme do sistema, então toca mesmo com o telefone no silencioso. O iOS vai perguntar duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick использует системный будильник, поэтому звучит даже в беззвучном режиме. iOS запросит разрешение дважды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick sistem alarmını kullanır, bu yüzden telefonun sessizdeyken bile çalar. iOS sana iki kez soracak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 使用系统闹钟，即使手机静音也会响。iOS 会向你请求两次权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawnwick 使用系統鬧鐘，即使手機靜音也會響。iOS 會向你要求兩次權限。"
          }
        }
      }
    },
