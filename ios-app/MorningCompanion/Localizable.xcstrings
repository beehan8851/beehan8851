    "%@ can't be used with VoiceOver — solve Math instead." : {
      "comment" : "Mission substituted with math under VoiceOver",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lässt sich mit VoiceOver nicht nutzen – löse stattdessen Mathe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se puede usar con VoiceOver: resuelve Matemáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être utilisée avec VoiceOver — résolvez un calcul à la place."
