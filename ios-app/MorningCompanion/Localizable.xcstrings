    "Unlock every mission, every alarm and your full sleep history." : {
      "comment" : "Paywall subtitle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte alle Missionen, alle Wecker und deinen vollständigen Schlafverlauf frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea todas las misiones, todas las alarmas y tu historial de sueño completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez toutes les missions, toutes les alarmes et tout votre historique de sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca tutte le missioni, tutte le sveglie e l'intera cronologia del sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのミッション、すべてのアラーム、そして全睡眠履歴が使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 미션, 모든 알람, 전체 수면 기록을 잠금 해제하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie todas as missões, todos os alarmes e seu histórico de sono completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте все задания, все будильники и полную историю сна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm görevlerin, tüm alarmların ve tam uyku geçmişinin kilidini aç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁全部任务、全部闹钟和完整睡眠历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖全部任務、全部鬧鐘和完整睡眠紀錄。"
          }
        }
      }
    },
    "Up to three, in this order. Touch and hold one to move or remove it." : {
      "comment" : "Missions section footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei, in dieser Reihenfolge. Halte eine Mission gedrückt, um sie zu verschieben oder zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta tres, en este orden. Mantén pulsada una misión para moverla o quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'à trois, dans cet ordre. Touchez longuement une mission pour la déplacer ou la retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
