    "The accelerometer isn't available on this device, so the Jump mission can't be used." : {
      "comment" : "Jump mission unavailable",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Beschleunigungssensor ist auf diesem Gerät nicht verfügbar, deshalb lässt sich die Sprung-Mission nicht nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acelerómetro no está disponible en este dispositivo, así que la misión Saltar no se puede usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accéléromètre n'est pas disponible sur cet appareil, la mission Saut est donc indisponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accelerometro non è disponibile su questo dispositivo, quindi la missione Salto non è utilizzabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは加速度センサーを利用できないため、ジャンプミッションは使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 가속도계를 사용할 수 없어 점프 미션을 쓸 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acelerômetro não está disponível neste dispositivo, então a missão Pulo não pode ser usada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акселерометр недоступен на этом устройстве, поэтому задание «Прыжки» использовать нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
